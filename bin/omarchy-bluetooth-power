#!/bin/bash

# omarchy:summary=Turn Bluetooth on or off, remembered at login
# omarchy:group=bluetooth
# omarchy:args=<on|off|toggle|is-on|save|restore|monitor> [on|off]
# omarchy:examples=omarchy bluetooth power off | omarchy bluetooth power save off

# Normal off is BlueZ Powered=false, not an rfkill block: applications such as
# Chromium can set Powered=true, but cannot lift the block for a phone passkey.
# Persist the preference separately and restore it in the graphical session.
set -o pipefail

POWER_WAIT_SECONDS=${OMARCHY_BLUETOOTH_POWER_WAIT_SECONDS:-5}
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/bluetooth-power"

controllers() {
  busctl --system --timeout=1 tree org.bluez --list 2>/dev/null |
    awk '/^\/org\/bluez\/hci[0-9]+$/'
}

# Any powered controller counts as on, but missing hardware or an unavailable
# bus is not an off preference: never overwrite saved state with either.
power_state() {
  local adapters adapter value state=off
  adapters=$(controllers) || return 1
  [[ -n $adapters ]] || return 1

  for adapter in $adapters; do
    value=$(busctl --system --timeout=1 get-property org.bluez "$adapter" org.bluez.Adapter1 Powered 2>/dev/null) || return 1
    case "$value" in
      "b true") state=on ;;
      "b false") ;;
      *) return 1 ;;
    esac
  done

  echo "$state"
}

remember() {
  local staged
  mkdir -p "$(dirname "$STATE_FILE")" || return 1
  staged=$(mktemp "$STATE_FILE.XXXXXX") || return 1
  if printf '%s\n' "$1" >"$staged" && mv -f "$staged" "$STATE_FILE"; then
    return 0
  else
    rm -f "$staged"
    return 1
  fi
}

set_power() {
  local direction=$1 value=false adapters adapter confirmed deadline=$((SECONDS + POWER_WAIT_SECONDS))
  [[ $direction == "on" ]] && value=true
  adapters=$(controllers) || return 1
  [[ -n $adapters ]] || return 1

  # Address every adapter, not just bluetoothctl's default. Retry during BlueZ
  # transitions (notably AutoEnable after lifting an old rfkill block), and
  # confirm the requested state before recording a successful change.
  while :; do
    confirmed=true
    for adapter in $adapters; do
      if [[ $(busctl --system --timeout=1 get-property org.bluez "$adapter" org.bluez.Adapter1 Powered 2>/dev/null) != "b $value" ]]; then
        busctl --system --timeout=1 set-property org.bluez "$adapter" org.bluez.Adapter1 Powered b "$value" >/dev/null 2>&1 || true
        [[ $(busctl --system --timeout=1 get-property org.bluez "$adapter" org.bluez.Adapter1 Powered 2>/dev/null) == "b $value" ]] || confirmed=false
      fi
    done
    [[ $confirmed == "true" ]] && return 0
    ((SECONDS < deadline)) || break
    sleep 0.2
  done

  echo "omarchy-bluetooth-power: adapter did not turn $direction" >&2
  return 1
}

restore_power() {
  [[ -f $STATE_FILE ]] || return 0
  local state
  read -r state <"$STATE_FILE" || return 1
  case "$state" in
    on|off) set_power "$state" ;;
    *) echo "omarchy-bluetooth-power: invalid saved state" >&2; return 1 ;;
  esac
}

power_on() {
  # Explicitly turning on in Omarchy can still recover a software block set by
  # another tool. Restoring a preference at login must not override that block.
  rfkill unblock bluetooth && set_power on && remember on
}

power_off() {
  set_power off && remember off
}

case "${1:-}" in
  on)
    power_on
    ;;
  off)
    power_off
    ;;
  toggle)
    if [[ $(power_state) == "on" ]]; then
      power_off
    else
      power_on
    fi
    ;;
  is-on)
    [[ $(power_state) == "on" ]]
    ;;
  save)
    # An explicit preference lets migrations use the same atomic write path
    # even when BlueZ is down. Without an argument, snapshot actual power.
    case "${2:-}" in
      on|off) state=$2 ;;
      "") state=$(power_state) || exit 0 ;;
      *) echo "omarchy-bluetooth-power: invalid preference" >&2; exit 1 ;;
    esac
    remember "$state"
    ;;
  restore)
    # A saved preference can outlive a USB adapter or an available daemon.
    power_state >/dev/null || exit 0
    restore_power
    ;;
  monitor)
    # Type=simple keeps the unit active (including its logout snapshot) even
    # when BlueZ is initially unavailable. Retry until the preference can be
    # restored; do not force bluetoothd to start or lift external radio blocks.
    if [[ -f $STATE_FILE ]]; then
      until power_state >/dev/null && restore_power; do
        sleep 2
      done
    fi
    exec sleep infinity
    ;;
  *)
    echo "Usage: omarchy-bluetooth-power <on|off|toggle|is-on|save|restore|monitor> [on|off]" >&2
    exit 1
    ;;
esac
